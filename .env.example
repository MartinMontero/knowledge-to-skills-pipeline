# ─────────────────────────────────────────────────────────────────────────────
# Knowledge-to-Skills Pipeline — environment configuration
#
# Every value is OPTIONAL. With no configuration the app runs in a fully
# functional demo mode (skill responses are generated locally, no database).
# Copy this file to `.env.local` and fill in what you need.
# ─────────────────────────────────────────────────────────────────────────────

# --- Language model (enables live skill execution) ---------------------------
# Without this key the app serves clearly-labelled demo responses.
# Get a key at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Model id (default: claude-opus-4-8). Use a cheaper model to reduce cost,
# e.g. claude-haiku-4-5.
LLM_MODEL=claude-opus-4-8

# Max generated tokens per invocation (default 2048, bounds cost/latency).
LLM_MAX_TOKENS=2048

# --- Database (optional, for invocation analytics) ---------------------------
# libSQL / SQLite. Leave unset to run without persistence.
#   Local file:  file:./data/app.db
#   Turso:       libsql://your-db.turso.io   (+ DATABASE_AUTH_TOKEN)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# --- Rate limiting (per client IP, invoke endpoint) --------------------------
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_SECONDS=60

# --- Input limits ------------------------------------------------------------
MAX_INPUT_LENGTH=4000

# --- Branding / metadata -----------------------------------------------------
APP_NAME=Knowledge-to-Skills Pipeline
# Public URL of the deployment (used for absolute links / Open Graph).
SITE_URL=
